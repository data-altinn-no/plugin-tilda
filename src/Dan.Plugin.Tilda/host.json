{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": false
            }
        },
        "logLevel": {
            "default": "Information",
            "Microsoft": "Warning"
        }
    },
    "extensions": {
        "http": {
            "maxConcurrentRequests": 80,
            "maxOutstandingRequests": 1500
        }
    }
}
