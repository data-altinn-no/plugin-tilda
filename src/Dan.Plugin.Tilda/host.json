{
    "version": "2.0",
    "extensions": {
        "http": {
            "maxConcurrentRequests": 80,
            "maxOutstandingRequests": 1500
        }
    },
    "telemetryMode": "OpenTelemetry",
    "logging": {
        "logLevel": {
            "default": "Information",
            "Microsoft": "Warning"
        },
        "OpenTelemetry": {
            "logLevel": {
                "default": "Information",
                "Microsoft": "Warning"
            }
        }
    }
}
